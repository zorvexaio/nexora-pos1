# انسخ هذا الملف إلى .env (أو صدّر المتغيرات مباشرة) قبل تشغيل server/sync-server.js
# لا تنشر ملف .env الحقيقي في أي مستودع.

# المنفذ الذي يستمع عليه سيرفر المزامنة
PORT=8787

# مسار قاعدة بيانات المزامنة المركزية (تُنشأ تلقائياً إن لم تكن موجودة)
POS_SYNC_DB=./central-sync.db

# أقصى عدد طلبات مزامنة لكل IP في الدقيقة (حماية أساسية من إساءة الاستخدام)
POS_SYNC_RATE_LIMIT=30

# ملاحظة: لا يوجد توكن مشترك بعد الآن — كل فرع له مفتاحه الخاص، يُدار عبر:
#   node tools/manage-branch-keys.js add --branch <branch-uuid> --label "..."
# راجع docs/CENTRAL_SYNC_PROTOCOL.md للتفاصيل الكاملة.
